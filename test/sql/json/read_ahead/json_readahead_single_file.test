# name: test/sql/json/read_ahead/json_readahead_single_file.test
# description: A single ND-JSON file split into multiple buffer claims through the read-ahead queue
# group: [read_ahead]

require json

statement ok
SET threads=8

# buffers are maximum_object_size (16MB) sized - pad the rows so the file spans several buffers
statement ok
COPY (SELECT range AS i, repeat('x', 40) AS s FROM range(0, 800000)) TO '{TEST_DIR}/json_ra_single.ndjson' (FORMAT json)

foreach depth -1 1

statement ok
SET read_ahead_depth={depth}

loop x 0 2

query II
SELECT count(*), sum(i) FROM read_json('{TEST_DIR}/json_ra_single.ndjson')
----
800000	319999600000

endloop

endloop

statement ok
RESET read_ahead_depth

# explicitly specified columns have no bind-time reader, which keeps the scan on the synchronous path
query II
SELECT count(*), sum(i) FROM read_json('{TEST_DIR}/json_ra_single.ndjson', format='newline_delimited', records=true, columns={'i': 'BIGINT', 's': 'VARCHAR'})
----
800000	319999600000
