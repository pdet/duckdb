# name: test/sql/json/read_ahead/json_readahead_multi_file.test
# description: ND-JSON scans through the read-ahead queue preserve insertion order across files
# group: [read_ahead]

require json

statement ok
SET threads=8

statement ok
COPY (SELECT range AS i FROM range(0, 100000)) TO '{TEST_DIR}/json_ra_0.ndjson' (FORMAT json)

statement ok
COPY (SELECT range AS i FROM range(100000, 200000)) TO '{TEST_DIR}/json_ra_1.ndjson' (FORMAT json)

statement ok
COPY (SELECT range AS i FROM range(200000, 300000)) TO '{TEST_DIR}/json_ra_2.ndjson' (FORMAT json)

statement ok
COPY (SELECT range AS i FROM range(300000, 400000)) TO '{TEST_DIR}/json_ra_3.ndjson' (FORMAT json)

foreach depth -1 3 1 0

statement ok
SET read_ahead_depth={depth}

loop x 0 3

query I
SELECT count(*) FROM (
    SELECT i, row_number() OVER () AS rn
    FROM read_json(['{TEST_DIR}/json_ra_0.ndjson', '{TEST_DIR}/json_ra_1.ndjson', '{TEST_DIR}/json_ra_2.ndjson', '{TEST_DIR}/json_ra_3.ndjson'])
) WHERE i + 1 <> rn
----
0

endloop

endloop

statement ok
RESET read_ahead_depth

# union_by_name goes through the union reader path
statement ok
COPY (SELECT range AS i, range * 2 AS j FROM range(0, 1000)) TO '{TEST_DIR}/json_ra_union.ndjson' (FORMAT json)

query II
SELECT count(*), sum(j) FROM read_json(['{TEST_DIR}/json_ra_0.ndjson', '{TEST_DIR}/json_ra_union.ndjson'], union_by_name=true)
----
101000	999000
